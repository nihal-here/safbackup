<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Section: Name -->
        <TextView
            android:text="@string/section_name"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/nameInput"
            android:hint="@string/hint_job_name"
            android:inputType="textCapWords"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Section: Source Folder -->
        <TextView
            android:text="@string/section_source"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/sourceButton"
            android:text="@string/choose_source"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/sourceText"
            android:text="@string/not_selected"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="@drawable/bg_folder_card"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Section: Destination Folder -->
        <TextView
            android:text="@string/section_dest"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/destButton"
            android:text="@string/choose_dest"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/destText"
            android:text="@string/not_selected"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="@drawable/bg_folder_card"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Section: Options -->
        <TextView
            android:text="@string/section_options"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/recursiveCheckBox"
            android:text="@string/opt_recursive"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/autoDailyCheckBox"
            android:text="@string/opt_auto_daily"
            android:checked="true"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="@string/note_auto_daily_inexact"
            android:textSize="12sp"
            android:textColor="@color/ui_on_surface_variant"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/wifiOnlyCheckBox"
            android:text="@string/wifi_only"
            android:checked="true"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/chargingOnlyCheckBox"
            android:text="@string/charging_only"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Section: Notifications -->
        <TextView
            android:text="@string/label_notif_pref"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/notifSpinner"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Section: Save / Cancel Buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/saveButton"
                android:text="@string/btn_save"
                android:minHeight="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/cancelButton"
                android:text="@string/btn_cancel"
                style="?attr/materialButtonOutlinedStyle"
                android:minHeight="48dp"
                android:layout_marginStart="12dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
